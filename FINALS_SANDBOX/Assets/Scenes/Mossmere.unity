  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Mossmere.VillagerDialogue
  characterName: Fern - Woodland Keeper
  lines:
  - Good day! I'm Fern. I look after this little woodland cottage.
  - The forest grows close around these paths, but every trail has a quiet place
    worth finding.
  - If you lose your way, look for a glowing ring. It will bring you safely back
    to the village.
  greetingRadius: 1.65
