  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cf7faf9f016d7974887c30c98d37e9c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Mossmere.VillagerDialogue
  characterName: Rowan - Lake Watcher
  lines:
  - Hello there! I'm Rowan. The lake is wonderfully peaceful today.
  - I come here to listen to the water and watch travelers discover the island.
  - That light by the pier is a return beacon. It leads home, so you can keep exploring
    without worry.
  greetingRadius: 1.65
