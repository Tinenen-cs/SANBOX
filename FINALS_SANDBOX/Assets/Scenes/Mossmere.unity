  m_Script: {fileID: 11500000, guid: cf7faf9f016d7974887c30c98d37e9c1, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Mossmere.VillagerDialogue
  characterName: Mira - Village Guide
  lines:
  - Hello, traveler! Welcome to Mossmere. Take your time and make yourself at home.
  - These paths connect our village to the meadow, woodland cottage and lakeside
    pier.
  - The glowing rings were left by the island's pathkeepers. Step into one whenever
    you want to come back home.
  greetingRadius: 1.65
